# Copy to .env and adjust. Values below work with docker-compose.yml out of the box.

# Django
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL (used by both the db container and Django)
POSTGRES_DB=estore_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DB_HOST=db
DB_PORT=5432

# Redis (Celery broker and result backend)
REDIS_URL=redis://redis:6379/0

# Elasticsearch
ELASTICSEARCH_URL=http://elasticsearch:9200

# E-mail – MailHog catches everything at http://localhost:8025
# Leave EMAIL_HOST empty to print e-mails to the console instead.
EMAIL_HOST=mailhog
EMAIL_PORT=1025
EMAIL_USE_TLS=False
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@barrelgarden.local
